#!/usr/bin/env bash
# testo — launch the interactive testing-harness REPL with the right interpreter,
# rooted at the repo (so tools resolve repo-relative paths regardless of $PWD).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$DIR/.." && pwd)"
PY="$REPO/context-layer/content-extractor/_lib/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3)"
cd "$REPO"
exec "$PY" "$DIR/repl.py" "$@"

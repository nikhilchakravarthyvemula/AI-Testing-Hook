{
  "name": "console-login-graph",
  "description": "Log in via Keycloak, land on the graph view, sanity-check the page. Hand-authored stand-in for test-plan-creator output (see field provenance in the plan).",
  "baseUrl": "https://console-preview.superalign.ai",
  "timeoutMs": 30000,

  "auth": {
    "type": "storageState",
    "storageStatePath": "output/crawler/auth-state.json",
    "loginUrlRegex": "(auth\\.superalign\\.ai|accounts\\.google\\.com|/realms/|/login|sign-?in)",
    "_note": "superalign uses Google SSO via Keycloak — not automatable headlessly. Do a one-time interactive login (cd scripts/crawler && npm run login), which saves the session to storageStatePath; this test then reuses it. For non-SSO apps, set type to 'login-form' and provide emailSelector/passwordSelector/submitSelector + $LOGIN_EMAIL/$LOGIN_PASSWORD.",
    "emailSelector": "#username, input[name='username'], input[type='email']",
    "passwordSelector": "#password, input[name='password'], input[type='password']",
    "submitSelector": "#kc-login, button[type='submit'], input[type='submit']",
    "email": "$LOGIN_EMAIL",
    "password": "$LOGIN_PASSWORD",
    "postLoginUrlContains": "/graph"
  },

  "steps": [
    { "action": "assert", "type": "urlContains", "value": "console-preview.superalign.ai" },
    { "action": "navigate", "url": "/graph", "waitFor": "load", "expectUrl": "/graph" },
    { "action": "assert", "type": "visible", "selector": "body" },
    { "action": "assert", "type": "titleContains", "value": "Surface" }
  ],

  "perf": {
    "webVitals": {
      "thresholds": { "lcpMs": 2500, "fcpMs": 1800, "clsScore": 0.1, "ttfbMs": 800, "loadMs": 4000 }
    },
    "httpFlow": [
      { "method": "GET", "path": "/api/graph",  "auth": true },
      { "method": "GET", "path": "/api/assets", "auth": true }
    ],
    "jmeter": {
      "vus": 10,
      "rampUpS": 5,
      "durationS": 30,
      "thresholds": { "p95Ms": 800, "errorRatePct": 1 }
    }
  }
}

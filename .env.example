# .env.example — copy to .env and fill in. `ctx.mjs` loads this file itself;
# variables you export in the shell always win over values here.
#
# Knob authority: byo-llm-poc/config.mjs (the registry). A scan prints the
# effective config at startup and warns about set-but-ignored or legacy knobs.

# ── target ───────────────────────────────────────────────────────────────────
BASE_URL=https://your-app.example.com
# Entry route(s). SEED_PATHS (comma-separated) overrides SEED_PATH.
SEED_PATH=/
#SEED_PATHS=/,/admin

# Source repo for code extractors + graphify (leave empty for live-crawl only).
TARGET_CODEBASE=

# ── credentials (never commit a real .env) ───────────────────────────────────
LOGIN_EMAIL=
LOGIN_PASSWORD=

# ── pass-1 crawl shape ───────────────────────────────────────────────────────
# Workers default to 1: >1 contexts race single-use refresh tokens on
# rotating-SSO apps (OIDC/Keycloak/Firebase) and hollow out the scan.
# Raise only for plain cookie-session targets.
#CRAWL_WORKERS=1
# Wall-clock budget + page/depth caps for the pass-1 walker.
#CRAWL_BUDGET_MS=600000
#MAX_INTERACT_PAGES=200
#MAX_INTERACT_DEPTH=5
# 0 opens a visible browser — required for some SSO popup flows (COOP).
HEADLESS=0
# Delay between worker bring-ups; 0 is honored (plain-session apps only).
#WORKER_STAGGER_MS=2500
# Max wait for async table/grid rows before scanning a page.
#CRAWL_TABLE_WAIT_MS=30000
# Regex of routes to exclude deliberately (e.g. heavy canvas/WebGL pages that
# crash the renderer). Excluded routes are recorded as route-skipped.
#CRAWL_SKIP_ROUTES=/graph
# Cap identical list-item drill-downs per nav group (unbounded by default).
#MAX_LIST_ITEMS_PER_NAV=3

# ── deep-crawl pass 2 ONLY (the pass-1 walker ignores DEEP_*) ────────────────
#DEEP_BUDGET_MS=300000
#DEEP_MAX_PAGES=60
#DEEP_WORKERS=1
#DEEP_MAX_CLICKS=5
#DEEP_TABLE_WAIT_MS=10000

# ── click safety (defaults are sane; override per-app when needed) ───────────
#SAFE_CLICK_REGEX=.+
#SAFE_CLICK_MAX_PER_PAGE=
#NEVER_CLICK_REGEX=
#INTERCEPT_MODE=abort
#INTERCEPT_BLOCK_POST=writes

# ── auth selectors (auto-detected; set only when detection fails) ────────────
#LOGIN_URL_REGEX=/(login|sign-?in|signin|auth)
#LOGIN_EMAIL_SELECTOR=
#LOGIN_PASSWORD_SELECTOR=
#LOGIN_SUBMIT_SELECTOR=
#LOGIN_SUBMIT_TEXT=Sign in
# Manual real-browser login fallback (saves output/crawler/auth-state.json).
#CRAWL_INTERACTIVE_LOGIN=1
#LOGIN_MAX_WAIT_MS=300000

# ── extractor orchestration ──────────────────────────────────────────────────
# Skip sources by id, e.g. SKIP=crawler for codebase-only scans.
#SKIP=
#PARALLEL=1
#MAX_PARALLEL=8

# ── generators ───────────────────────────────────────────────────────────────
#E2E_MAX_FLOWS=12
#E2E_MAX_DEPTH=5
#API_BASE=
#TEST_BEARER=

# ── execution / reporting (see byo-llm-poc + run-pipeline.sh docs) ───────────
#EXECUTE_MAX_MINUTES=15
#TEST_TIMEOUT_MS=30000
#REPORT_SKIP_PDF=0

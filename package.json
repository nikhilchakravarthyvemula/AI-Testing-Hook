{
  "name": "testing-harness",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "description": "Architecture-shaped testing harness. See README.md for folder → diagram mapping.",
  "bin": {
    "testo": "testo/testo"
  },
  "scripts": {
    "testo": "./testo/testo",
    "login": "BASE_URL=$(node -p \"require('./scenario.json').baseUrl\") SEED_PATH=/ node context-layer/content-extractor/crawler/login-once.mjs",
    "test:ui": "node generation-layer/ui-test-generator/gen.mjs scenario.json",
    "test:perf": "node generation-layer/perf-test-generator/gen.mjs scenario.json",
    "report:build": "node generation-layer/allure-reporter/build.mjs",
    "report": "node generation-layer/ui-test-generator/gen.mjs scenario.json ; node generation-layer/perf-test-generator/gen.mjs scenario.json ; node generation-layer/allure-reporter/build.mjs --serve",
    "report:html": "node generation-layer/ui-test-generator/gen.mjs scenario.json ; node generation-layer/perf-test-generator/gen.mjs scenario.json ; node generation-layer/allure-reporter/build.mjs --generate",
    "pdf": "node generation-layer/pdf-reporter/build-pdf.mjs",
    "report:pdf": "node generation-layer/ui-test-generator/gen.mjs scenario.json ; node generation-layer/perf-test-generator/gen.mjs scenario.json ; node generation-layer/pdf-reporter/build-pdf.mjs",
    "extract": "node context-layer/content-extractor/run.mjs",
    "extract:live": "ONLY=crawler npm run --silent extract",
    "extract:code": "SKIP=crawler npm run --silent extract",
    "extract:fastapi": "ONLY=python-fastapi npm run --silent extract",
    "crawler": "cd context-layer/content-extractor/crawler && npm run all",
    "graphify": "context-layer/content-extractor/_lib/.venv/bin/python testo/harness/agentic_harness/tools/graphify/tool.py",
    "code-ast": "context-layer/content-extractor/_lib/.venv/bin/python context-layer/content-extractor/code-extractors/python-ast/extract.py"
  },
  "workspaces": [
    "context-layer/content-extractor/crawler"
  ]
}
